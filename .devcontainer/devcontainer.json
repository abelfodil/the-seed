{
    "name": "The Seed devcontainer",
    "build": {
        "context": "..",
        "dockerfile": "./Dockerfile"
    },
    "remoteUser": "vscode",
    "mounts": [
        "type=bind,source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh"
    ],
    "extensions": [
        "rust-lang.rust",
        "visualstudioexptteam.vscodeintellicode",
        "mads-hartmann.bash-ide-vscode",
        "ms-azuretools.vscode-docker",
        "bungcip.better-toml"
    ]
}